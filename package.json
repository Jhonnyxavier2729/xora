{
  "name": "xora",
  "version": "0.1.0",
  "private": true,
  "description": "Lienzo infinito para trabajar con agentes de código, terminales, editor, navegador, notas, voz y acceso remoto.",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "simple-git": "^4.0.2",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.52.2",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "dev.xora.app",
    "productName": "Xora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/uiohook-napi/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
